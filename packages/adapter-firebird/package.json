{
  "name": "@prisma/adapter-firebird",
  "version": "0.0.0",
  "description": "Prisma's driver adapter for Firebird 3",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/prisma/orm.git",
    "directory": "packages/adapter-firebird"
  },
  "scripts": {
    "dev": "DEV=true tsx helpers/build.ts",
    "build": "tsx helpers/build.ts",
    "test": "vitest run"
  },
  "files": [
    "dist",
    "README.md",
    "MODIFICATIONS.md",
    "LICENSE"
  ],
  "license": "Apache-2.0",
  "sideEffects": false,
  "dependencies": {
    "@prisma/driver-adapter-utils": "workspace:*",
    "node-firebird": "2.18.2"
  }
}
